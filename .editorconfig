# Editor defaults for every file. Line width is not set here: Prettier owns it
# (the "prettier" key in package.json). @see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces are a hard line break in Markdown.
[*.{md,mdx}]
trim_trailing_whitespace = false
