{
  "name": "portfolio-weblog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "turbo run build --filter=web",
    "start": "pnpm --filter web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "content:check": "pnpm --filter @workspace/content check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm content:check && pnpm --filter web icons:check && pnpm knip && pnpm test",
    "prepare": "simple-git-hooks",
    "media:add": "pnpm --filter @workspace/content media:add",
    "icons:sync": "pnpm --filter web icons:sync",
    "avatar:build": "pnpm --filter @workspace/content avatar:build",
    "wow:sync": "pnpm --filter web wow:sync",
    "linkedin:import": "pnpm --filter web linkedin:import",
    "knip": "knip"
  },
  "devDependencies": {
    "knip": "^6.49.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "turbo": "2.11.11",
    "vercel": "66.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,json,md,mdx,yml,yaml,css}": "prettier --write"
  },
  "prettier": {
    "printWidth": 140,
    "trailingComma": "es5",
    "overrides": [
      {
        "files": "*.json",
        "options": {
          "printWidth": 100
        }
      },
      {
        "files": [
          "*.md",
          "*.mdx"
        ],
        "options": {
          "proseWrap": "always",
          "printWidth": 80
        }
      },
      {
        "files": "*.config.{js,mjs,ts}",
        "options": {
          "printWidth": 100
        }
      }
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --quiet"
  },
  "knip": {
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "ignoreDependencies": [
      "circle-flags"
    ]
  }
}
