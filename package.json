{
  "name": "portfolio-weblog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "content:check": "pnpm --filter @workspace/content check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm content:check && pnpm --filter web icons:check && pnpm test",
    "prepare": "husky",
    "media:add": "pnpm --filter @workspace/content media:add",
    "icons:sync": "pnpm --filter web icons:sync",
    "avatar:build": "pnpm --filter @workspace/content avatar:build",
    "wow:sync": "pnpm --filter web wow:sync",
    "linkedin:import": "pnpm --filter web linkedin:import"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "vercel": "66.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,json,md,mdx,yml,yaml,css}": "prettier --write"
  },
  "prettier": {
    "printWidth": 140,
    "trailingComma": "es5",
    "overrides": [
      {
        "files": "*.json",
        "options": {
          "printWidth": 100
        }
      },
      {
        "files": [
          "*.md",
          "*.mdx"
        ],
        "options": {
          "proseWrap": "always",
          "printWidth": 80
        }
      },
      {
        "files": "*.config.{js,mjs,ts}",
        "options": {
          "printWidth": 100
        }
      }
    ]
  }
}
