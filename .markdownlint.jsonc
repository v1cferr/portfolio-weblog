// Markdown rules for every repository on the owner's machines: tables are
// aligned, with a pipe at the start and end of each row.
{
  "default": true,
  // Prose is wrapped by hand; long lines and inline HTML are deliberate.
  "MD013": false,
  "MD033": false,
  "MD055": { "style": "leading_and_trailing" },
  "MD060": { "style": "aligned" }
}
