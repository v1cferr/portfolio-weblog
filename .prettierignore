# Prettier already skips everything in .gitignore; these are tracked files it
# must leave alone.

# Lock files are never reformatted
pnpm-lock.yaml

# Static assets
apps/web/public/

# Generated by pnpm icons:sync
apps/web/src/generated/

# Claude Code worktrees: separate checkouts of other branches (ignored only by
# the owner's global gitignore, which Prettier does not read)
.claude/

# Prettier parses MDX as MDX 1 and mangles {/* comments */}, which hold the
# owner's review notes in job stories
content/experiences/*/story.*.mdx
