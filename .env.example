# All variables are optional for local development.

# Read-only GitHub token (no scopes) to raise the API rate limit for repository
# metadata. Server-side only; never exposed to the browser.
GITHUB_TOKEN=

# Canonical origin used in metadata, sitemap, RSS and Open Graph.
# Defaults to https://v1cferr.dev.
NEXT_PUBLIC_SITE_URL=

# Spotify "now playing" on the home page. Server-side only; without them the
# player stays hidden. Create the app at https://developer.spotify.com/dashboard
# (Development Mode needs the owner on Spotify Premium since 2026-03-09), add
# http://127.0.0.1:3000/api/auth/callback as a redirect URI, then issue the
# refresh token with `pnpm --filter web spotify:token`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
