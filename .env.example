# Copy this file to .env.local and fill in the values.
# .env.local is gitignored: never commit real credentials.
#
# "Production" below means the variable also has to exist in the Vercel project
# settings. The others are only needed to run the authorisation flows locally.

# =================================================
# APPLICATION
# =================================================

# Origin the Blizzard routes build their redirects from. No trailing slash.
# Local: http://127.0.0.1:3000   Production: https://v1cferr.dev
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000

# =================================================
# SPOTIFY (production)
# https://developer.spotify.com/dashboard
# =================================================

# Credentials of the app registered in the dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match one of the Redirect URIs registered on the app byte for byte.
# Spotify refuses "localhost": a loopback address has to be the literal IP,
# so use 127.0.0.1. Change the port if the dev server is not on 3000.
# Local only: the authorisation flow never runs in production.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Minted by visiting /api/login and authorising; the callback returns it as
# JSON. /api/spotify trades it for a short-lived access token on every request.
# It does not expire on its own, but changing the account password or removing
# the app at https://www.spotify.com/account/apps/ revokes it, and it then has
# to be minted again.
#
# The token belongs to the client that issued it. Pointing SPOTIFY_CLIENT_ID at
# a different app invalidates it, so the pair always has to be replaced
# together.
SPOTIFY_REFRESH_TOKEN=

# =================================================
# BATTLE.NET (production)
# https://develop.battle.net/access/clients
# =================================================

BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=

# A PATH, not a full URL: the routes send `${NEXT_PUBLIC_BASE_URL}/${this}`.
# No leading slash.
BATTLENET_REDIRECT_URI=api/blizzard/token

# Opaque value echoed back on the OAuth callback to detect request tampering.
BATTLENET_STATE=

# =================================================
# SUPABASE (production)
# Project settings > API
# =================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=

# =================================================
# GOOGLE SHEETS (production)
# https://console.cloud.google.com/apis/credentials
# =================================================

# API key for the Sheets v4 API. The spreadsheet id and cell range are
# hardcoded in src/app/api/google/sheets/route.ts, not configured here.
GOOGLE_SHEETS_API_KEY=
