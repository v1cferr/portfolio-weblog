{
  // TypeScript compiler settings
  "compilerOptions": {
    // ECMAScript version the code is compiled down to
    "target": "es2017",
    // Standard library definitions available to the project
    "lib": [
      "dom", // DOM type definitions
      "dom.iterable", // Type definitions for iterable DOM objects
      "esnext" // Type definitions for the latest ECMAScript features
    ],
    // Allows JavaScript files to be part of the project
    "allowJs": true,
    // Skips type checking of library definition files
    "skipLibCheck": true,
    // Enables the strict type-checking family of options
    "strict": true,
    // Type checking only: never write output files
    "noEmit": true,
    // Enables interoperability with ES modules
    "esModuleInterop": true,
    // Module system to emit
    "module": "esnext",
    // Module resolution strategy
    "moduleResolution": "bundler",
    // Allows importing JSON files as modules
    "resolveJsonModule": true,
    // Ensures every file is treated as a standalone module
    "isolatedModules": true,
    // How JSX is transformed
    "jsx": "react-jsx",
    // Enables incremental compilation for faster rebuilds
    "incremental": true,
    // Additional compiler plugins
    "plugins": [
      {
        // Next.js specific plugin
        "name": "next"
      }
    ],
    // Maps import paths to specific directories
    "paths": {
      "@/*": [
        "./src/*" // Maps the "@" alias to the "src" directory
      ]
    }
  },
  // Files included in the project
  "include": [
    "next-env.d.ts", // Next.js type definitions
    "**/*.ts", // Every TypeScript file
    "**/*.tsx", // Every TypeScript file with JSX
    ".next/types/**/*.ts", // Types generated by Next.js
    ".next/dev/types/**/*.ts"
  ],
  // Files and directories kept out of the project
  "exclude": [
    "node_modules", // Node.js dependencies
    "supabase", // The Supabase directory
    "supabase/functions" // Edge functions, which target Deno and type-check on their own
  ]
}
